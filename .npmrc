# No lock file: every SurveyJS package takes a `^3.1.1` range, and a lock would freeze where in that range it lands.
package-lock=false
# Node 24.16 or later, refused otherwise: earlier 24.x node:sqlite truncates a string
# at its first NUL character, which silently corrupts stored JSON. See src/storage/backend/sqlite.ts.
engine-strict=true
