# SurveyJS commercial license key — the full edition only.
#
# It unlocks Survey Creator, PDF Generator and Dashboard. This edition is
# MIT-licensed and ships none of them, so leave it unset: the code that would
# apply it (src/lib/surveyjs-license.ts) is present and simply never runs.
# Unset in the full edition, those products still work and mark their output.
#
# Unlike the keys below it reaches the browser, because that is where the
# designer runs. It is forwarded by the `env` block in next.config.mjs, not by
# a NEXT_PUBLIC_ prefix — keep the two in step if you rename it.
NEXTJS_PUBLIC_SLK=".."

# Reading answers off a document — /api/extract, both editions.
#
# Set one of these, not both; whichever is present picks the provider. They are
# read on the server and never reach the browser. With neither set the route
# answers 501 and the button on /records says so, so the feature is wired and
# starts working the moment a key appears.
OPENAI_API_KEY=".."
ANTHROPIC_API_KEY=".."

# Optional: uncomment to override the model the extractor uses. Each provider
# has a default — gpt-4o with OPENAI_API_KEY, claude-sonnet-5 with
# ANTHROPIC_API_KEY; see src/app/api/extract/route.ts.
# EXTRACTOR_MODEL="your-model-name"
