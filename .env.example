# SurveyJS license key.
#
# When it is set, src/lib/surveyjs-license.ts applies it to the SurveyJS
# library on every page that renders a form. It unlocks Survey Creator, PDF
# Generator and Dashboard in the full edition; left empty, nothing is applied
# and those products still run and mark their output.
#
# Unlike the extractor keys below it reaches the browser. It is forwarded by the `env`
# block in next.config.mjs, not by a NEXT_PUBLIC_ prefix — keep the two in
# step if you rename it.
SURVEYJS_KEY=""

# Reading answers off a document — /api/extract, both editions.
#
# Set one of these, not both; whichever is present picks the provider. They are
# read on the server and never reach the browser. With neither set the route
# answers 501 and the buttons on /work-orders say so, so the feature is wired and
# starts working the moment a key appears.
OPENAI_API_KEY=".."
ANTHROPIC_API_KEY=".."

# Optional: uncomment to override the model the extractor uses. Each provider
# has a default — gpt-4o with OPENAI_API_KEY, claude-sonnet-5 with
# ANTHROPIC_API_KEY; see src/app/api/extract/route.ts.
# EXTRACTOR_MODEL="your-model-name"

# Per-visitor storage — src/storage/backend/sqlite.ts, both editions.
#
# Read on the server only, at the first request that touches storage. Each
# visitor's definitions, records and uploaded documents live in one SQLite
# file, keyed by a random `demo_uid` cookie.
#
# Where that file is. Unset, it is .data/demo.db, and the directory is created.
# ":memory:" is accepted for a throwaway run that keeps nothing past a restart.
# The e2e suite never opens this: it uses a temp file of its own.
# DATABASE_PATH=".data/demo.db"
#
# How many idle days a visitor's sandbox survives before the garbage collector
# removes it. Unset, it is 14. `npm run storage:gc` runs the same cleanup by hand.
# STORAGE_TTL_DAYS="14"

# Page metadata — src/lib/metadata.ts, both editions.
#
# Read at build time and inlined, so a change needs a rebuild. None is secret.
#
# This host, with no trailing slash. REQUIRED ON EVERY DEPLOYMENT: canonicals
# and og:url are built from it, and unset it is http://localhost:3000, so a
# production build or start without it prints an error saying so (it does not
# fail: the e2e suite runs production builds with none). This file is shared by
# both editions, so uncomment the line for the edition being deployed.
# The full edition:
# NEXT_PUBLIC_SITE_URL="https://app.demos.surveyjs.io"
# The MIT edition:
# NEXT_PUBLIC_SITE_URL="https://app-mit.demos.surveyjs.io"
#
# Optional: the host canonicals point at, when it is not this one. Unset, every
# page is canonical to itself. Setting it on the MIT host to the full edition's
# URL makes the full host win every query both serve.
# NEXT_PUBLIC_CANONICAL_URL="https://app.demos.surveyjs.io"
#
# "false" adds noindex to every page and disallows crawling in robots.txt.
# Unset or anything else: indexable.
# NEXT_PUBLIC_INDEXABLE="true"

# The examples manifest — src/examples/, both editions.
#
# Read at build time and inlined, like the metadata above. The dock's "More
# examples" menu, the root index and the "See next" card all render from it.
#
# Where the site publishes the manifest. Unset, the copy bundled in
# src/examples/manifest.json is used. A URL that fails (unreachable, slower than
# three seconds, not JSON, not a valid manifest) logs one line and falls back to
# that same copy, so the menu is never empty. Fetched on the server, reused for
# five minutes.
# No URL is published yet; this one is a placeholder.
# NEXT_PUBLIC_EXAMPLES_MANIFEST_URL="https://example.com/examples/manifest.json"
#
# "true" also lists the entries the manifest marks `ready: false`, in the menu
# and on the root index. For previewing an example before it is announced.
# NEXT_PUBLIC_SHOW_UNREADY="false"
