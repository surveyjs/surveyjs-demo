# SurveyJS license key.
#
# When it is set, src/lib/surveyjs-license.ts applies it to the SurveyJS
# library on every page that renders a form. It unlocks Survey Creator, PDF
# Generator and Dashboard in the full edition; left empty, nothing is applied
# and those products still run and mark their output.
#
# Unlike the extractor keys below it reaches the browser. It is forwarded by the `env`
# block in next.config.mjs, not by a NEXT_PUBLIC_ prefix — keep the two in
# step if you rename it.
SURVEYJS_KEY=""

# Reading answers off a document — /api/extract, both editions.
#
# Set one of these, not both; whichever is present picks the provider. They are
# read on the server and never reach the browser. With neither set the route
# answers 501 and the button on /claims says so, so the feature is wired and
# starts working the moment a key appears.
OPENAI_API_KEY=".."
ANTHROPIC_API_KEY=".."

# Optional: uncomment to override the model the extractor uses. Each provider
# has a default — gpt-4o with OPENAI_API_KEY, claude-sonnet-5 with
# ANTHROPIC_API_KEY; see src/app/api/extract/route.ts.
# EXTRACTOR_MODEL="your-model-name"

# Page metadata — src/lib/metadata.ts, both editions.
#
# Read at build time and inlined, so a change needs a rebuild. None is secret.
#
# This host, with no trailing slash. Canonicals and og:url are built from it, so
# set it on every deployment: https://app.demos.surveyjs.io for the full edition,
# https://app-mit.demos.surveyjs.io for the MIT one. Unset, it is
# http://localhost:3000.
# NEXT_PUBLIC_SITE_URL="https://app.demos.surveyjs.io"
#
# Optional: the host canonicals point at, when it is not this one. Unset, every
# page is canonical to itself. Setting it on the MIT host to the full edition's
# URL makes the full host win every query both serve.
# NEXT_PUBLIC_CANONICAL_URL="https://app.demos.surveyjs.io"
#
# "false" adds noindex to every page and disallows crawling in robots.txt.
# Unset or anything else: indexable.
# NEXT_PUBLIC_INDEXABLE="true"
